# Copy to .env and fill in real values. Never commit .env.

# --- Twilio (required for SMS + voice) ---
# Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Voice-capable Twilio number in E.164 (same number often used for SMS on trial)
TWILIO_PHONE_NUMBER=+15017122661

# Optional aliases (if unset, TWILIO_PHONE_NUMBER is used)
# TWILIO_SMS_FROM=+15017122661
# TWILIO_VOICE_FROM=+15017122661

# Your phone for interactive CLI defaults (must be verified on Twilio trial)
TEST_PHONE_NUMBER=+919876543210

# --- Voice webhooks (interactive calls) ---
# Local port for FastAPI (twilio_apps/call/webhook_server.py). Point ngrok at this port, e.g.:
#   ngrok http 8765
VOICE_WEBHOOK_PORT=8765

# Public HTTPS origin Twilio uses for /voice/* (NO trailing slash). Update when ngrok restarts.
# Set any ONE of these (same value):
#   PUBLIC_VOICE_BASE_URL=https://xxxx.ngrok-free.app
#   NGROK_PUBLIC_URL=https://xxxx.ngrok-free.app
#   NGROK_VOICE_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_VOICE_BASE_URL=
NGROK_PUBLIC_URL=
NGROK_VOICE_BASE_URL=

# ngrok auth token (only if you use built-in pyngrok from python -m twilio_apps.call.app without --no-ngrok)
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Anthropic (optional but recommended for personalised voice replies) ---
# Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- KrishiMitra microservice URLs (main app) ---
M1_URL=http://localhost:8001
M2_URL=http://localhost:8002
M4_URL=http://localhost:8004
M5_URL=http://localhost:8005
M6_URL=http://localhost:8006
M7_URL=http://localhost:8007
M8_URL=http://localhost:8008
M9_URL=http://localhost:8009
M10_URL=http://localhost:8010
M11_URL=http://localhost:8011
M12_URL=http://localhost:8012
M13_URL=http://localhost:8013
M14_URL=http://localhost:8014
M15_URL=http://localhost:8015
M16_URL=http://localhost:8016

# --- WhatsApp Web (Neonize — demo; see whatsapp_apps/README.md) ---
# Your phone for CLI defaults (10 digits or +91...)
TEST_WHATSAPP_NUMBER=9876543210
# Session DB directory (default: whatsapp_apps/web/sessions/)
# WHATSAPP_SESSION_DIR=whatsapp_apps/web/sessions
# WHATSAPP_SESSION_NAME=krishimitra

# --- WhatsApp via Twilio (optional alternative) ---
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Dry run (optional) ---
# TWILIO_DRY_RUN=true
