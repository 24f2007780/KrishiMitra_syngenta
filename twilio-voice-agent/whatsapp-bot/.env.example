# Copy to .env in this folder (or rely on repo root .env)

GEMINI_API_KEY=
LLM_MODEL=gemini-3-flash-preview

# false = show Chrome (needed for first QR scan). true = headless (often breaks on WA Web).
# Shell exports win over .env files (see config load_dotenv_layers).
WHATSAPP_HEADLESS=false

# Extra polling logs + 90s heartbeat (why no reply / unread-only behaviour).
# WHATSAPP_VERBOSE=true

# Only direct (1:1) chats are answered; group chats are always ignored.
# Comma-separated chat titles (exact match to WhatsApp sidebar name). Empty = all 1:1 chats.
# WHATSAPP_ALLOWED_CHATS=Alice,+91 98765 43210

# Optional extra Chrome flags (space-separated), e.g. for Linux servers:
# WHATSAPP_CHROME_ARGS=--no-sandbox --disable-dev-shm-usage
