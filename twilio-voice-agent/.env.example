# Twilio (KrishiMitra_syngenta root .env is also loaded — same names work)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public URL Twilio reaches (ngrok https URL, no trailing slash)
TUNNEL_LINK=
NGROK_PUBLIC_URL=
PUBLIC_VOICE_BASE_URL=

# Gemini (required for voice AI)
GEMINI_API_KEY=
# Optional: GOOGLE_APPLICATION_CREDENTIALS=google/your-service-account.json

# Voice engine: gemini_live (default) or pipeline (STT -> LLM -> TTS)
VOICE_ENGINE=gemini_live
LIVE_API=1
LIVE_API_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Server
PORT=8000
HOST=127.0.0.1

# Optional human transfer (retailer / agent phone)
HUMAN_AGENT_NUMBER=+91xxxxxxxxxx
